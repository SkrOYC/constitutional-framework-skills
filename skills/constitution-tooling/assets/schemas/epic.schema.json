{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic.schema.json",
  "title": ".constitution/tasks/epics/EPIC-<ID>-<slug>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "capabilities", "depends_on", "scope", "tickets"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/epicId" },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["tooling", "foundation", "product", "out_of_band"],
      "description": "out_of_band epics come from an issue, sit outside the critical path, and still obey every other rule"
    },
    "priority": { "type": "integer", "minimum": 1, "description": "Lower runs first when two epics could share a wave; defaults to file order" },
    "source": { "type": "string", "description": "Origin of an out_of_band epic, for example github#42 or an audit report path" },
    "capabilities": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/capabilityId" }, "uniqueItems": true },
    "depends_on": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/epicId" }, "uniqueItems": true, "description": "Epic-level dependencies; the only way to express a cross-epic need" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "tech_spec_patchable"],
      "properties": {
        "paths": { "$ref": "common.schema.json#/$defs/pathList", "description": "Root paths this epic owns; disjointness is checked on these" },
        "out_of_scope": { "$ref": "common.schema.json#/$defs/pathList" },
        "tech_spec_patchable": { "$ref": "common.schema.json#/$defs/pathList", "description": "tech-spec files a spec-patch worker may edit for this epic" }
      }
    },
    "estimated_diff_lines": { "type": "integer", "minimum": 0, "description": "Planned size before execution; never back-filled from actuals. An active epic without one is TSK-015." },
    "estimate_source": {
      "type": "string",
      "enum": ["planned", "migrated", "backfilled"],
      "description": "Where estimated_diff_lines came from; absent means planned. Only planned estimates count toward calibration (INFO-CAL)."
    },
    "tickets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ticket" }
    },
    "decisions": {
      "description": "Decisions discovered during execution, recorded by the epic lead; reconciliation copies them to the register as proposed",
      "type": "array",
      "items": { "$ref": "open-decisions.schema.json#/$defs/decision" }
    },
    "closeout": { "$ref": "#/$defs/closeout" }
  },
  "$defs": {
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "effort", "depends_on", "scope", "verification", "description", "acceptance", "flows", "certainty", "status"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/ticketId" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["Feature", "Chore", "Spike", "Security"] },
        "effort": { "$ref": "common.schema.json#/$defs/effort" },
        "depends_on": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ticketId" }, "uniqueItems": true, "description": "Tickets in the same epic only" },
        "category": { "type": "string", "enum": ["Correctness", "Security", "Perf", "Tech-Debt", "Dependency-Upgrade", "DX", "Docs", "Feature-Evolution"], "description": "Only for tickets planned from an audit finding" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in"],
          "properties": {
            "in": { "$ref": "common.schema.json#/$defs/pathList" },
            "out": { "$ref": "common.schema.json#/$defs/pathList" }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "expected"],
          "properties": {
            "command": { "type": "string", "minLength": 1, "description": "Quoted from guidelines verification_commands" },
            "expected": { "type": "string", "minLength": 1 }
          }
        },
        "stop_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string", "minLength": 1, "description": "Behavioral level, no code" },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "evidence"],
          "properties": {
            "mode": { "$ref": "common.schema.json#/$defs/acceptanceMode" },
            "supplementary": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/acceptanceMode" } },
            "evidence": { "type": "string", "minLength": 1, "description": "Mode-specific evidence body" },
            "constraints": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/constraintId" }, "description": "PRD meters cited by benchmark or stat_threshold modes" },
            "recipe": { "$ref": "common.schema.json#/$defs/slug", "description": "Name of the guidelines live_verification recipe a live_probe ticket runs; required exactly when live_probe is the mode or a supplementary mode (TSK-014)" }
          }
        },
        "flows": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
        "spike": { "$ref": "common.schema.json#/$defs/spikeId", "description": "Required when type is Spike" },
        "closes_decision": { "$ref": "common.schema.json#/$defs/odId", "description": "The open decision a Spike ticket exists to close" },
        "certainty": { "$ref": "common.schema.json#/$defs/certainty", "description": "settled when every contract, schema, and boundary the ticket touches is settled; assumed otherwise" },
        "status": { "type": "string", "enum": ["planned", "in_progress", "done", "deferred", "blocked"] },
        "deferred_to": { "type": "string", "description": "Stage or work item a deferred ticket was routed to" },
        "deviations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["files", "justification"],
            "properties": {
              "files": { "$ref": "common.schema.json#/$defs/pathList" },
              "justification": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "closeout": {
      "description": "Written by the epic lead as the last change on the branch; the only record reconciliation reads",
      "type": "object",
      "additionalProperties": false,
      "required": ["tickets_completed", "tickets_deferred", "points_completed", "spec_patches", "changelog_entries", "candidate_terms", "routed_upstream", "follow_ups", "settled"],
      "properties": {
        "tickets_completed": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ticketId" }, "uniqueItems": true },
        "tickets_deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "route", "reason"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/ticketId" },
              "route": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "points_completed": { "type": "integer", "minimum": 0 },
        "spec_patches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "summary", "commit"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
            }
          }
        },
        "changelog_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["directory", "type", "text"],
            "properties": {
              "directory": { "$ref": "common.schema.json#/$defs/stage" },
              "type": { "type": "string", "enum": ["added", "changed", "deprecated", "removed", "fixed", "security"] },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "candidate_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "where"],
            "properties": { "term": { "type": "string", "minLength": 1 }, "where": { "type": "string", "minLength": 1 } }
          }
        },
        "routed_upstream": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "item"],
            "properties": { "stage": { "$ref": "common.schema.json#/$defs/stage" }, "item": { "type": "string", "minLength": 1 } }
          }
        },
        "follow_ups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "code_decisions": {
          "description": "Decisions the code made that tech-spec does not record yet: new dependencies, patterns, conventions, contract shapes. Reconcile routes each to Stage 3 for a ruling.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "kind", "paths", "commit"],
            "properties": {
              "summary": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["dependency", "pattern", "convention", "contract_shape", "other"] },
              "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
            }
          }
        },
        "settled": {
          "description": "Records this epic settled by exercising them in code; reconciliation flips their certainty with this evidence",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record", "evidence"],
            "properties": {
              "record": { "type": "string", "minLength": 1, "description": "File path plus record id, for example tech-spec/contracts/api.openapi.yaml or prd/capabilities.yaml#CAP-003" },
              "evidence": { "$ref": "common.schema.json#/$defs/evidence" }
            }
          }
        },
        "actuals": {
          "description": "Filled by reconcile, never by hand",
          "type": "object",
          "additionalProperties": false,
          "required": ["diff_lines", "files_touched", "milestones", "review_rounds", "merged_commit", "measured_at"],
          "properties": {
            "diff_lines": { "type": "integer", "minimum": 0 },
            "files_touched": { "type": "integer", "minimum": 0 },
            "milestones": { "type": "integer", "minimum": 0 },
            "review_rounds": { "type": "integer", "minimum": 0 },
            "merged_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
            "measured_at": { "$ref": "common.schema.json#/$defs/date" },
            "per_ticket": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "diff_lines", "review_rounds"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/ticketId" },
                  "diff_lines": { "type": "integer", "minimum": 0 },
                  "review_rounds": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  }
}
