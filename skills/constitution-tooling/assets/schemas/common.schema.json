{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions for constitution data files",
  "$defs": {
    "semver": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "acronym": { "type": "string", "pattern": "^[A-Z]{2,6}$" },
    "epicId": { "type": "string", "pattern": "^[A-Z]{1,2}$" },
    "ticketId": { "type": "string", "pattern": "^[A-Z]{2,6}-[A-Z]{1,2}[0-9]{3}$" },
    "jobId": { "type": "string", "pattern": "^JOB-[0-9]{2,3}$" },
    "capabilityId": { "type": "string", "pattern": "^CAP-[0-9]{3}$" },
    "constraintId": { "type": "string", "pattern": "^NFC-[0-9]{2,3}$" },
    "boundaryId": { "type": "string", "pattern": "^BND-[0-9]{2,3}$" },
    "adrId": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
    "odId": { "type": "string", "pattern": "^OD-[0-9]{2,3}$" },
    "spikeId": { "type": "string", "pattern": "^SPK-[A-Z]{2,6}-[A-Z]{1,2}[0-9]{3}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
    "effort": { "type": "integer", "enum": [1, 2, 3, 5, 8] },
    "archetypeName": {
      "type": "string",
      "enum": ["Web/Cloud", "CLI/Tooling", "Library/SDK", "System/Native", "ML/Data", "Embedded/IoT", "Mobile", "Web3", "Game/Sim", "IaC/Platform", "Other"]
    },
    "acceptanceMode": {
      "type": "string",
      "enum": ["gherkin", "benchmark", "stat_threshold", "invariant", "hitl_sil", "visual_regression", "contract_test", "runbook_probe", "live_probe"]
    },
    "certainty": {
      "description": "settled needs evidence; assumed needs an assumption; open needs a decision id",
      "type": "string",
      "enum": ["settled", "assumed", "open"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "date"],
      "properties": {
        "kind": { "type": "string", "enum": ["repository", "external", "spike", "ruling", "measurement"] },
        "ref": { "type": "string", "minLength": 1, "description": "repository path, canonical URL, spike id, ruling reference, or evidence/ directory" },
        "version": { "type": "string", "description": "commit SHA, package version, or document revision the evidence was checked against; on a stack pin it is the package version, and the document revision goes in note" },
        "date": { "$ref": "#/$defs/date" },
        "note": { "type": "string" }
      }
    },
    "certaintyBlock": {
      "description": "Fields every binding record carries. Validation of the cross-field rule lives in the checker (CERT-*).",
      "type": "object",
      "properties": {
        "certainty": { "$ref": "#/$defs/certainty" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "assumption": { "type": "string", "minLength": 1 },
        "decision": { "$ref": "#/$defs/odId" },
        "settles_when": { "type": "string" }
      },
      "required": ["certainty"]
    },
    "pathList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stage": { "type": "string", "enum": ["prd", "architecture", "tech-spec", "tasks"] },
    "surfaceKind": {
      "type": "string",
      "enum": ["http", "async", "json", "rpc", "cli", "library", "native", "mobile", "ml", "embedded", "web3", "game", "iac", "data-model", "other"]
    }
  }
}
